{
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "vite"
        },
        "converter": {
            "root": "services/converter"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "converter"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "web"
            }
        }
    ]
}
